# Environment
NODE_ENV=production
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/avencix?retryWrites=true&w=majority
# alternative name supported by code
MONGODB_URI=
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Frontend / CORS
# Accepts either a comma-separated list or a JSON array.
# Example: CLIENT_URL=https://dkrtrucking.com,https://www.dkrtrucking.com,http://localhost:5173,http://localhost:3000
# Or: CLIENT_URL=["https://dkrtrucking.com","https://www.dkrtrucking.com","http://localhost:5173","http://localhost:3000"]
CLIENT_URL=https://dkrtrucking.com,https://www.dkrtrucking.com,http://localhost:5173,http://localhost:3000
FRONTEND_URL=

# Socket.IO
SOCKET_ENABLED=true
SOCKET_IO_ORIGIN=https://dashboard.example.com
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Monitoring / Logging
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=info

# Limits
BODY_PARSER_LIMIT=50mb

# Optional scripts
LOGIN_EMAIL=devadmin@local
LOGIN_PASS=DevPass123
URL=http://localhost:5000/api/auth/admin-setup
PORT=
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLIENT_URL=
NODE_ENV=
